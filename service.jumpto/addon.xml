<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.jumpto" 
       name="JumpTo" 
       version="1.0.5" 
       provider-name="Nervix">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.service" library="service.py" />
    <extension point="xbmc.addon.metadata">
        <summary lang="fr">Bouton pour sauter les génériques de début</summary>
        <description lang="fr">Possiblité de faire sauter le générique de début, basé sur un fichier JSON distant.</description>
        <platform>all</platform>
        <assets>
        <icon>icon.png</icon>
    </assets>
    </extension>
</addon>